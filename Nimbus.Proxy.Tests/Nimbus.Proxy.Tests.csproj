<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(FrameworkVersion)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!--
      fixtures/ holds plugin projects of its own. Without this the test assembly would glob their
      sources and their obj/ output in as if they were its own files.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);fixtures\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <!-- Emits the opencover report the sonar workflow feeds to SonarCloud. -->
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- HttpRegistryClientTests boots a real registry on a loopback port to talk to. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nimbus.Proxy\Nimbus.Proxy.csproj" />
    <ProjectReference Include="..\Nimbus.Registry.Core\Nimbus.Registry.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Plugin dlls PluginLoaderTests loads for real through the collectible load context. Built
      before the tests but deliberately not referenced: the loader has to resolve their types
      by reflection, which it cannot do honestly if the test host has already got them loaded.
    -->
    <ProjectReference Include="..\Nimbus.SamplePlugin\Nimbus.SamplePlugin.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="fixtures\Nimbus.BrokenPlugin\Nimbus.BrokenPlugin.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="fixtures\Nimbus.ShutdownPlugin\Nimbus.ShutdownPlugin.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!--
    Drops those three dlls (and the sample's manifest) into a folder beside the test binaries.
    PluginLoaderTests copies out of it into a scratch directory per test, so a test that rewrites
    a manifest cannot disturb the next one.
  -->
  <Target Name="StagePluginFixtures" AfterTargets="Build">
    <ItemGroup>
      <PluginFixture Include="..\Nimbus.SamplePlugin\bin\$(Configuration)\$(TargetFramework)\Nimbus.SamplePlugin.dll" />
      <PluginFixture Include="..\Nimbus.SamplePlugin\bin\$(Configuration)\$(TargetFramework)\Nimbus.SamplePlugin.plugin.json" />
      <PluginFixture Include="fixtures\Nimbus.BrokenPlugin\bin\fixture\Nimbus.BrokenPlugin.dll" />
      <PluginFixture Include="fixtures\Nimbus.ShutdownPlugin\bin\fixture\Nimbus.ShutdownPlugin.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginFixture)" DestinationFolder="$(OutDir)plugin-fixtures" SkipUnchangedFiles="true" />
  </Target>

  <!--
    The built proxy, staged beside the test binaries. ProxyBootTests copies it into a scratch
    directory and runs it there: Program reads its config out of the directory the binary sits in,
    so booting the real thing against a chosen config means giving it a directory of its own, and
    an exit code is only observable from a process that actually exited.

    A nimbus.proxy.toml left in the proxy's own output folder by a hand run is deliberately not
    carried along, since each test writes the config it wants to boot.
  -->
  <Target Name="StageProxyApp" AfterTargets="Build">
    <ItemGroup>
      <!-- Item globs ignore case, so the exclusions have to name the config files rather than
           reach for nimbus.proxy.*, which also matches Nimbus.Proxy.dll. -->
      <ProxyAppFile Include="..\Nimbus.Proxy\bin\$(Configuration)\$(TargetFramework)\*"
                    Exclude="..\Nimbus.Proxy\bin\$(Configuration)\$(TargetFramework)\nimbus.proxy.toml;
                             ..\Nimbus.Proxy\bin\$(Configuration)\$(TargetFramework)\nimbus.proxy.json*" />
    </ItemGroup>
    <Copy SourceFiles="@(ProxyAppFile)" DestinationFolder="$(OutDir)proxy-app" SkipUnchangedFiles="true" />
  </Target>
</Project>
